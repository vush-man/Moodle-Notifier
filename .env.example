MOODLE_URL=https://lms.dituniversity.edu.in
# Raw 32-char token, or the full moodlemobile://token=... string from the launch.php step
MOODLE_TOKEN=

# Telegram: create a bot with @BotFather, then run `python moodle_bot.py --get-chat-id`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
POLL_MINUTES=15
# Reminders (hours before the deadline) for quizzes and other calendar deadlines
REMINDER_HOURS=24,3
# Reminders for assignments you have NOT submitted yet (48 = 2 days, 24 = 1 day)
ASSIGN_REMINDER_HOURS=48,24
# How often to check for new content (in hours)
FULL_CHECK_HOURS=3
# Comma-separated course ids to ignore (old/irrelevant courses)
SKIP_COURSE_IDS=
# Minutes offset from UTC for displayed times (330 = India)
TZ_OFFSET_MINUTES=330
DB_PATH=moodle_bot.db
